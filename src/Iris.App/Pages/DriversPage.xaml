<Page x:Class="Iris.App.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16" MaxWidth="900" HorizontalAlignment="Left">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="Drivers" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="Iris detects drivers and points you to the official source. There is intentionally no in-app install button: Samsung's EULA forbids redistributing its driver, so you download and run Samsung's own installer yourself (as administrator)." TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Command="{Binding RefreshCommand}" /><ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" /></StackPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding Drivers}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Name}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Installed:" FontWeight="SemiBold" /><TextBlock Text="{Binding IsInstalled}" /><TextBlock Text="{Binding Version}" /></StackPanel>
                            <TextBlock Text="{Binding InstallationNote}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="Open official source and install it yourself" NavigateUri="{Binding InformationUri}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
