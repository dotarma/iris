<Page x:Class="Iris.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Iris" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Making custom ROMs on Samsung devices easier." Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.7"><TextBlock Text="Version" /><TextBlock Text="{Binding Version}" /></StackPanel>
            </StackPanel>
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Action failed" Message="{Binding ErrorMessage}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel><TextBlock Text="Platform tools" FontWeight="SemiBold" /><TextBlock Text="{Binding ToolsStatus}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel><TextBlock Text="Drivers" FontWeight="SemiBold" /><TextBlock Text="{Binding DriverStatus}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel><TextBlock Text="ADB" FontWeight="SemiBold" /><TextBlock Text="{Binding AdbVersion}" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel><TextBlock Text="Fastboot" FontWeight="SemiBold" /><TextBlock Text="{Binding FastbootVersion}" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>
            <StackPanel Spacing="8">
                <TextBlock Text="Target device" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" PlaceholderText="No device detected" MinWidth="320"
                          AutomationProperties.AutomationId="HomeDeviceSelector" />
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="Quick actions" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="Refresh" Icon="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshDevices" />
                    <AppBarButton Label="ADB devices" Icon="List" Command="{Binding AdbDevicesCommand}" />
                    <AppBarButton Label="Fastboot devices" Icon="List" Command="{Binding FastbootDevicesCommand}" />
                    <AppBarSeparator />
                    <AppBarButton Label="Reboot" Icon="Refresh" Click="Reboot_Click" Tag="normal" />
                    <AppBarButton Label="Recovery" Icon="Repair" Click="Reboot_Click" Tag="recovery" />
                    <AppBarButton Label="Bootloader" Icon="Setting" Click="Reboot_Click" Tag="bootloader" />
                </CommandBar>
            </StackPanel>
            <TextBox Header="Last command output" Text="{Binding LastOutput}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" MinHeight="120" FontFamily="Consolas" />
        </StackPanel>
    </ScrollViewer>
</Page>
