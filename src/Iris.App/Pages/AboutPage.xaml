<Page x:Class="Iris.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Iris" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Making custom ROMs on Samsung devices easier." Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Iris is an open-source Windows toolkit designed to make working with ADB, Fastboot, drivers, and Samsung custom ROM workflows easier." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Version" /><TextBlock Text="{Binding Version}" /></StackPanel>
            <TextBlock Text="MIT License. Third-party components retain their own licenses and copyrights." />
            <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/dotarma/iris" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check for updates" Click="Check_Click" />
                <Button Content="Download verified update" Click="Download_Click" IsEnabled="{Binding CanDownload}" />
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Maximum="100" />
            <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" />
        </StackPanel>
    </ScrollViewer>
</Page>
