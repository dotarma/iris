<Page x:Class="Iris.App.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" MaxWidth="1040" HorizontalAlignment="Left">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="Logs &amp; Diagnostics" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="Technical state for troubleshooting. No device credentials or personal files are collected." /></StackPanel>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton Label="Refresh" Icon="Refresh" Click="Refresh_Click" />
            <AppBarButton Label="Copy diagnostics" Icon="Copy" Click="Copy_Click" />
            <AppBarButton Label="Export diagnostics" Icon="Save" Click="Export_Click" />
            <AppBarButton Label="Export logs" Icon="Document" Click="ExportLogs_Click" />
        </CommandBar>
        <InfoBar Grid.Row="2" IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" />
        <TextBox Grid.Row="3" Text="{Binding DiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="300" />
    </Grid>
</Page>
