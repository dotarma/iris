<Page x:Class="Iris.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
            <ComboBox Header="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" />
            <TextBox Header="Platform-tools directory" Text="{Binding ToolDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Download directory" Text="{Binding DownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="brokkR executable" Text="{Binding BrokkrPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Absolute path to brokkr.exe" />
            <ToggleSwitch Header="Updates" OnContent="Check automatically" OffContent="Manual checks only" IsOn="{Binding AutomaticUpdates, Mode=TwoWay}" />
            <TextBlock Text="Update source: github.com/dotarma/iris, branch: update" Opacity="0.7" />
            <Button Content="Save settings" Click="Save_Click" HorizontalAlignment="Left" />
            <InfoBar x:Name="SavedInfo" IsOpen="False" Severity="Success" Title="Settings saved" Message="The theme applies immediately." />
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" />
        </StackPanel>
    </ScrollViewer>
</Page>
