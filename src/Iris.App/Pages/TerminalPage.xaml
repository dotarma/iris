<Page x:Class="Iris.App.Pages.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" MaxWidth="1040" HorizontalAlignment="Left">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="ADB / Fastboot" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="Restricted direct command execution. Only adb and fastboot are allowed; no shell is used." TextWrapping="Wrap" /></StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{Binding HasError}" Severity="Error" Title="Command rejected or failed" Message="{Binding ErrorMessage}" />
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Command" PlaceholderText="adb devices -l"
                     AutomationProperties.AutomationId="RestrictedCommandInput" KeyDown="Command_KeyDown" />
            <Button Grid.Column="1" Content="Run" Click="Run_Click" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RunCommand" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Bottom" />
        </Grid>
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Right">
                <AppBarButton Label="Copy" Icon="Copy" Click="Copy_Click" />
                <AppBarButton Label="Clear" Icon="Delete" Command="{Binding ClearCommand}" />
            </CommandBar>
            <TextBox Grid.Row="1" Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                     TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="280" />
        </Grid>
    </Grid>
</Page>
