<Page x:Class="Iris.App.Pages.PlatformToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Platform Tools" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Detect or install ADB and Fastboot from Google's official HTTPS distribution. Existing installations are never overwritten without this explicit Update action." TextWrapping="Wrap" />
            <InfoBar IsOpen="True" Severity="Informational" Title="Android SDK terms"
                     Message="Google's Platform-Tools archive is not part of Iris. Review and accept the Android SDK license before downloading." />
            <CheckBox Content="I have reviewed and accept the Android SDK license for this download"
                      IsChecked="{Binding LicenseAccepted, Mode=TwoWay}" AutomationProperties.AutomationId="AcceptAndroidSdkLicense" />
            <TextBox Header="Expected SHA-256 (optional but recommended)" Text="{Binding ExpectedSha256, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="64 hexadecimal characters from a trusted release note" AutomationProperties.AutomationId="PlatformToolsSha256" FontFamily="Consolas" />
            <TextBlock Text="Without a checksum Iris can only verify the archive structure, not that it matches a known good release. Paste a checksum when available." TextWrapping="Wrap" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Detect" Command="{Binding DetectCommand}" AutomationProperties.AutomationId="PlatformToolsDetect" />
                <Button Content="Install / Update from Google" Command="{Binding InstallCommand}" AutomationProperties.AutomationId="PlatformToolsInstall" />
                <Button Content="Cancel" Command="{Binding CancelInstallCommand}" AutomationProperties.AutomationId="PlatformToolsCancel" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" />
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Maximum="100" />
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" />
            <TextBlock Text="{Binding Status}" FontFamily="Consolas" TextWrapping="Wrap" />
            <HyperlinkButton Content="Review Android SDK license and Platform-Tools releases"
                             NavigateUri="https://developer.android.com/tools/releases/platform-tools" />
        </StackPanel>
    </ScrollViewer>
</Page>
